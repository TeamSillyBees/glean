# Provision at $PRODUCTION_BASE_DIR/config/backend.env with mode 0600.
# Database identity/password comes from ops.env DATABASE_URL, not this file.
# Template ONLY; supply existing secrets privately on server. Not sourced as Bash.
INITRA_REDIS_ENABLED=true
INITRA_REDIS_ADDR=redis.internal.example.invalid:6379
INITRA_REDIS_PASSWORD=REPLACE_EXISTING_REDIS_PASSWORD
INITRA_TASK_REDIS_ADDR=redis.internal.example.invalid:6379
INITRA_TASK_REDIS_PASSWORD=REPLACE_EXISTING_REDIS_PASSWORD
INITRA_AUTH_JWT_SECRET=REPLACE_EXISTING_JWT_SECRET
INITRA_IDGEN_NODE=1
# Enable only after database restore/import, operator check, and source doctor.
INITRA_MONITOR_SCHEDULER_ENABLED=false
INITRA_MONITOR_OPERATOR_ID=REPLACE_EXISTING_ENABLED_USER_ID
