# Template ONLY. Provision /etc/glean/ops.env manually, owner-only (0600).
# Bash syntax; never put the populated file in a release or GitHub Actions.
# One connection is shared by pg_dump and Atlas, preventing backup/migration mismatch.
DATABASE_URL='postgres://REPLACE_USER:REPLACE_PASSWORD@db.example.invalid:5432/glean?sslmode=verify-full&sslrootcert=/etc/glean/db-ca.crt'
GLEAN_BACKEND_ENV=/etc/glean/backend.env
GLEAN_CONFIG_DIR=/etc/glean/configs
GLEAN_DATA_DIR=/var/lib/glean/data
# Private original user-provided archives; never substitute sanitized Git baselines.
GLEAN_ORIGINAL_ARCHIVE_DIR=/var/lib/glean/originals
GLEAN_BACKUP_ROOT=/var/lib/glean/backups
GLEAN_STATE_DIR=/var/lib/glean/deployment
