# Browser requests same-origin /api by default. Vite proxies them to the Go backend.
# Do not put secrets, LLM keys or access tokens in VITE_* variables.
GLEAN_API_PROXY=http://127.0.0.1:8080
# For a separately hosted API, configure the backend CORS allowlist explicitly.
# VITE_API_BASE_URL=https://api.example.com
